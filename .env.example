# ============================================================================
# Variabel lingkungan — salin file ini menjadi `.env` lalu isi nilainya.
#   cp .env.example .env
# Catatan: Nuxt/Node.js TIDAK otomatis memuat `.env`; `pnpm dev` memuatnya
# lewat Nitro, sedangkan skrip Prisma memuatnya lewat `dotenv`
# (lihat prisma7.config.ts).
# ============================================================================

# --- Database ---------------------------------------------------------------
# Koneksi PostgreSQL yang dipakai Prisma ORM.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=SCHEMA
DATABASE_URL="postgresql://postgres:password@localhost:5432/portfolio?schema=public"

# --- Aplikasi ---------------------------------------------------------------
# URL publik aplikasi (dipakai untuk link absolut bila dibutuhkan).
NUXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Autentikasi (Better Auth) ----------------------------------------------
# Rahasia enkripsi & hashing sesi. Wajib minimal 32 karakter dengan entropi
# tinggi; buat sendiri lewat `openssl rand -base64 32`.
# Dibaca langsung oleh Better Auth di server/utils/auth.ts.
# Nilai aslinya tidak boleh masuk VCS — `.env` sudah masuk .gitignore.
BETTER_AUTH_SECRET=""

# URL dasar aplikasi (login, cookie, dan callback Better Auth).
# Di production ganti dengan domain HTTPS yang sebenarnya.
# Origin dari URL ini sudah dipercaya otomatis oleh Better Auth.
BETTER_AUTH_URL="http://localhost:3000"

# Daftar origin tambahan yang dipercaya untuk pemeriksaan origin/CSRF
# saat login, pendaftaran, dan keluar. Pisahkan dengan koma (,) atau
# titik koma (;); spasi di sekitar tiap entri diabaikan.
#
# Setiap entri harus berupa origin asal browser persis: skema + host
# (+ port bila bukan port default), tanpa jalur dan tanpa garis miring
# di akhir. Catatan penting:
#   - `https://www.domainanda.example` adalah origin BERBEDA dari
#     `https://domainanda.example`; cantumkan keduanya bila keduanya
#     benar-benar dipakai.
#   - Bila memakai domain deploy Netlify, origin-nya berbentuk
#     `https://<nama-site>.netlify.app`.
#   - Jangan masukkan host saja (tanpa `https://`) atau URL berjalur
#     (mis. `https://domainanda.example/admin`).
#
# Jika daftar ini salah atau tidak terbaca runtime, request ke
# `/api/auth/*` dari browser dijawab `403 {"code":"INVALID_ORIGIN"}`.
# Daftar yang benar-benar terbaca dicatat pada log saat server mulai.
BETTER_AUTH_TRUSTED_ORIGINS="http://localhost:3000,https://domainanda.example"

# --- Fallback data ----------------------------------------------------------
# Saat true, endpoint API menyediakan data fallback bila database tidak
# bisa diakses (berguna untuk pratinjau lokal tanpa DB).
# Set "false" di production agar kegagalan DB terlihat jelas (HTTP 500).
ENABLE_FALLBACK_DATA="true"

# --- Upload gambar ----------------------------------------------------------
# Maksimum ukuran file gambar yang di-upload melalui POST /api/projects, dalam MB.
# Nilai ini dibaca oleh server/utils/upload.ts.
UPLOAD_MAX_IMAGE_MB="5"

# --- Upload file generik ----------------------------------------------------
# Maksimum ukuran file untuk POST /api/admin/upload (jenis file apa pun), dalam MB.
# Bila tidak diisi, nilai UPLOAD_MAX_IMAGE_MB dipakai sebagai cadangan.
UPLOAD_MAX_FILE_MB="5"
