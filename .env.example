# ============================================================================
# Variabel lingkungan — salin file ini menjadi `.env` lalu isi nilainya.
#   cp .env.example .env
# Catatan: Nuxt/Node.js TIDAK otomatis memuat `.env`; `pnpm dev` memuatnya
# lewat Nitro, sedangkan skrip Prisma memuatnya lewat `dotenv`
# (lihat prisma7.config.ts).
# ============================================================================

# --- Database ---------------------------------------------------------------
# Koneksi PostgreSQL yang dipakai Prisma ORM.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=SCHEMA
DATABASE_URL="postgresql://postgres:password@localhost:5432/portfolio?schema=public"

# --- Aplikasi ---------------------------------------------------------------
# URL publik aplikasi (dipakai untuk link absolut bila dibutuhkan).
NUXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Fallback data ----------------------------------------------------------
# Saat true, endpoint API menyediakan data fallback bila database tidak
# bisa diakses (berguna untuk pratinjau lokal tanpa DB).
# Set "false" di production agar kegagalan DB terlihat jelas (HTTP 500).
ENABLE_FALLBACK_DATA="true"

# --- Upload gambar ----------------------------------------------------------
# Maksimum ukuran file gambar yang di-upload melalui POST /api/projects, dalam MB.
# Nilai ini dibaca oleh server/utils/upload.ts.
UPLOAD_MAX_IMAGE_MB="5"

# --- Upload file generik ----------------------------------------------------
# Maksimum ukuran file untuk POST /api/admin/upload (jenis file apa pun), dalam MB.
# Bila tidak diisi, nilai UPLOAD_MAX_IMAGE_MB dipakai sebagai cadangan.
UPLOAD_MAX_FILE_MB="5"
